# VPS live paper environment.
# This file is intentionally paper-only. Do not add private keys here.

POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com

ORDERBOOK_STREAM_ENABLED=true
ORDERBOOK_STREAM_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
ORDERBOOK_STREAM_HEARTBEAT_SECONDS=10
ORDERBOOK_STREAM_RECONNECT_SECONDS=2
ORDERBOOK_STREAM_STALE_SECONDS=60
ORDERBOOK_REST_SNAPSHOT_ENABLED=true
ORDERBOOK_REST_SNAPSHOT_INTERVAL_SECONDS=60
RUNNER_HEALTH_STATUS_INTERVAL_SECONDS=5
# Market-discovery/WebSocket rebuild cycle.
STREAM_CYCLE_INTERVAL_SECONDS=2400
# Maximum city-date weather events to expand. One event can contain many binary markets.
# Fallback API pagination safety only. This does not limit supported cities or weather events.
DISCOVERY_MAX_PAGES=8
DISCOVERY_PAGE_SIZE=100

STATE_PATH=/opt/polymarket-weather-bot/data/paper_state.json
TRADES_CSV_PATH=/opt/polymarket-weather-bot/data/paper_trades.csv
DECISIONS_CSV_PATH=/opt/polymarket-weather-bot/data/paper_decisions.csv
SKIP_DIAGNOSTICS_ENABLED=true
SKIP_DIAGNOSTICS_JSONL_PATH=/opt/polymarket-weather-bot/data/paper_skip_diagnostics.jsonl
SKIP_DIAGNOSTICS_MAX_BYTES=10485760
SKIP_DIAGNOSTICS_ARCHIVE_MAX_BYTES=20971520
PORTFOLIO_DECISIONS_JSONL_PATH=/opt/polymarket-weather-bot/data/paper_event_portfolios.jsonl
RAW_SNAPSHOTS_PATH=/opt/polymarket-weather-bot/data/paper_raw_snapshots.jsonl
# Raw snapshots are high-volume diagnostics. Default saves only error evidence.
RAW_SNAPSHOTS_MODE=error
RAW_SNAPSHOTS_MAX_BYTES=104857600
RAW_SNAPSHOTS_RETENTION_DAYS=7
RAW_SNAPSHOTS_MIN_FREE_BYTES=1073741824
RAW_SNAPSHOTS_MAX_DISK_USAGE_PCT=0.90
STATION_NOWCAST_ENABLED=true
STATION_NOWCAST_CACHE_TTL_SECONDS=60
STATION_REFRESH_POLL_SECONDS=5
AWC_CURRENT_CACHE_ENABLED=true
AWC_DIRECT_CURRENT_ENABLED=true
KMA_PUBLIC_HTML_ENABLED=true
KMA_METAR_SERVICE_KEY=
KMA_METAR_POLL_SECONDS=30
KMA_METAR_TIMEOUT_SECONDS=3
KMA_METAR_STATION_IDS=RKSI,RKPK
# Weather Underground daily-history API key. Put the real value only in the server environment file.
# Required when STRATEGY_MODE=lock_only. Keep the real value only in the server env file.
WUNDERGROUND_API_KEY=
# AWC METAR is normally hourly, so this is its maximum age. HKO is separately capped at 20 minutes.
STATION_NOWCAST_FRESHNESS_SECONDS=5400
STATION_NOWCAST_REQUEST_LOG_PATH=/opt/polymarket-weather-bot/data/station_nowcast_request_log.jsonl
HKO_ROLLOVER_STATE_PATH=/opt/polymarket-weather-bot/data/hko_rollover_state.json
METAR_DAILY_EXTREMES_STATE_PATH=/opt/polymarket-weather-bot/data/metar_daily_extremes_state.json

# Money amounts must be greater than 0, and risk fractions must stay between 0 and 1.
BANKROLL_USD=1000
SIZE_MODE=kelly
ENTRY_FRACTION=0.20
FRACTIONAL_KELLY=0.25
MAX_SINGLE_MARKET_FRACTION=0.50
MAX_TOTAL_EXPOSURE_FRACTION=0.90
MAX_CITY_EXPOSURE_FRACTION=0.20
MAX_EVENT_DATE_EXPOSURE_FRACTION=0.10
LARGE_BANKROLL_EVENT_DATE_EXPOSURE_FRACTION=0.05
EVENT_DATE_EXPOSURE_TRANSITION_USD=1000
MAX_EVENT_PORTFOLIO_LEGS=2
DAILY_REALIZED_LOSS_LIMIT_FRACTION=0.50
DAILY_UNREALIZED_LOSS_LIMIT_FRACTION=0.50
LARGE_LOSS_THRESHOLD_FRACTION=0.50
MIN_ORDER_USD=10.00

OFFICIAL_NOWCAST_LOCK_ENABLED=true
OFFICIAL_NOWCAST_ENTRY_ONLY=false
OFFICIAL_NOWCAST_LOCK_BASE_ENTRY_FRACTION=0.20
OFFICIAL_NOWCAST_LOCK_STRONG_ENTRY_FRACTION=0.50
OFFICIAL_NOWCAST_LOCK_NEAR_CLOSE_HOURS=3.0
OFFICIAL_NOWCAST_LOCK_YES_BASE_BUFFER_C=0.50
OFFICIAL_NOWCAST_LOCK_YES_STRONG_BUFFER_C=0.75

# Personal paper validation uses same-station upstream observations.  Switch to
# lock_only only when a direct settlement-source WU key is configured.
STRATEGY_MODE=upstream_lock_paper
NO_ONLY_NEW_ENTRIES=true
INTRADAY_OBSERVATION_EDGE_ENABLED=true
INTRADAY_MIN_SIDE_PROBABILITY=0.90
INTRADAY_STRONG_SIDE_PROBABILITY=0.97
INTRADAY_BASE_ENTRY_FRACTION=0.10
INTRADAY_STRONG_ENTRY_FRACTION=0.25
INTRADAY_ABNORMAL_PRICE_ENTRY_FRACTION=0.35
INTRADAY_ABNORMAL_MIN_NET_EDGE=0.20
INTRADAY_HKO_NEEDS_AUDIT_FRACTION_MULTIPLIER=0.25
INTRADAY_EXACT_LOW_YES_ENABLED=false
INTRADAY_US_EXACT_LOW_YES_ENABLED=true
INTRADAY_ENABLE_ABOVE_BUCKET_NO=false

MIN_NET_EDGE=0.08
EXIT_NET_EDGE=0.00
ENTRY_MIN_EXPECTED_NET_RETURN_PCT=0.04
# Fee rate must stay between 0 and 1.
WEATHER_TAKER_FEE_RATE=0.05
MODEL_ERROR_MARGIN=0.03
RESOLUTION_ERROR_MARGIN=0.01
SETTLEMENT_RUNNER_ENABLED=true
SETTLEMENT_RUNNER_MAX_FRACTION=1.00
SETTLEMENT_RUNNER_MIN_EV_MARGIN_USD=0.00

PROBABILITY_STOP_DROP_THRESHOLD=0.10
MIN_PROFIT_PCT=0.08
TAKE_PROFIT_TO_FAIR_RATIO=0.70
OVERHEAT_MARGIN=0.02
EDGE_FADE_MAX_LOSS_PCT=0.02
MAX_HOLDING_HOURS=96

PROBABILITY_SHRINK_GAMMA=0.65
REQUIRE_PARSE_FOR_TRADE=true
REQUIRE_DATE_HINT_FOR_TRADE=true
# Paper strategy is temperature-only; non-temperature weather settings are intentionally absent.
